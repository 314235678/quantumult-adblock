# ===== source: 本地固化 · 微信生态去广告 (wechat_rewrite.conf) =====
# ============================================================
# 微信生态去广告 · Quantumult X 重写层（本地固化源）
# ------------------------------------------------------------
# 本文件由 build.py 优先合并进 rewrite.list（排在最前，优先级最高）。
# 放在本地而不是订阅上游，是为了两件事：
#   1) 修掉上游那几条「已失效却会抢占同一 URL」的坏规则；
#   2) 固化一条真正有效的公众号去广告规则，避免上游哪天改格式就失效。
#
# ⚠️ 能力边界（务必了解，不要期待超出范围的效菓）：
#   · 朋友圈广告       —— 做不到。朋友圈信息流走 mmtls 私有协议
#                        （公钥内置、不校验证书链 + 业务层二次加密），
#                        Quantumult X 的 MITM 只能看到密文，规则层无从下手。
#                        网上任何"圈X去朋友圈广告"规则要么是引流，要么是顺手
#                        把朋友圈图片 CDN 一起 reject（图也没了）。
#   · 公众号文章内广告 —— 可以，走标准 HTTPS，见下方 A 段。
#   · 公众号信息流广告 —— 做不到，服务端下发，与正常文章同接口。
#   · 小程序广告       —— 可以，但需按小程序逐个写规则，见下方 B 段。
# 数据来源：fmz200/wool_scripts · WeChatMiniAds.plugin（已按 QX 语法转换）
#           chxm1023/Advertising · wxgzhad.js
#           ddgksf2013/Rewrite · Applet.conf
# 整理日期：2026-10-24
# ========== A. 公众号文章去广告 ==========
# 原理：文章的广告数据来自 /mp/getappmsgad 返回的 JSON，
#       脚本把 advertisement_num 置 0、advertisement_info 清空。
# 说明：上游 ddgksf2013/WeChat.conf 与 fmz200 里还有三条旧写法
#       （response-body advertisement → 替换成作者名），作者自己标了【已失效】，
#       而且它们排在有效规则前面会抢占同一个 URL。build.py 里已按
#       REWRITE_DROP_PATTERNS 统一剔除，这里只保留有效的那一条。
^https?:\/\/mp\.weixin\.qq\.com\/mp\/getappmsgad url script-response-body https://raw.githubusercontent.com/chxm1023/Advertising/main/wxgzhad.js
# 移除公众号文章底栏「都在搜」
^https:\/\/mp\.weixin\.qq\.com\/mp\/relatedsearchword url reject-dict
# ========== B. 微信小程序去广告 ==========
# 只收「接口级、明确是广告位」的条目。
# 上游同一个插件里另有一批整站/CDN 级 reject，会打断正常功能，
# 已统一剔到文件末尾的风险区（默认注释，需要时自己开）。
# --- 点单类小程序（企迈系统：挪瓦、古茗等共用）---
^https:\/\/webapi\.qmai\.cn\/web\/catering\/advertising\/ url reject-dict
^https:\/\/webapi\.qmai\.cn\/web\/cmk-center\/marketing\/canvas\/advert-reach url reject
# --- 交通银行信用卡小程序 · 开屏广告 ---
^https:\/\/creditcardapp\.bankcomm\.com\/cnsvPmpaMdbcardWeb\/page\/getGuidePageAds url reject
# --- 丰巢 · 开通会员横幅 ---
^https:\/\/webchatapp\.fcbox\.com\/post\/suggestion\/query$ url reject-dict
# --- 中石油 / 中油好客 e 站 ---
^https:\/\/app\.95504\.net\/app\/json\/page_ad\/initPageAd\?ver= url reject
^https:\/\/minipro\.95504\.net\/app\/json\/ad\/getPopAdData url reject
^https:\/\/minipro\.95504\.net\/app\/json\/ad\/getIndexAdData url reject
# --- 多点 ---
^https:\/\/flow\.dmall\.com\/app\/home\/pops url reject
# --- 永辉 ---
^https:\/\/api\.yonghuivip\.com\/api\/fp\/homepage\/pop url reject
^https:\/\/activity\.yonghuivip\.com\/api\/app\/fp\/homepage\/pop url reject
^https:\/\/activity\.yonghuivip\.com\/api\/\/web\/shensuan\/ad url reject
^https:\/\/sauron-report\.yonghuivip\.com\/collect url reject
# --- 必胜客 ---
^https:\/\/res\.pizzahut\.com\.cn\/CRM url reject-dict
# --- 麦当劳 · 首页热门活动 ---
^https:\/\/api\.mcd\.cn\/bff\/portal\/home\/hotActivity url reject-dict
# --- 星巴克 ---
^https:\/\/3pp\.starbucks\.com\.cn\/wxmem\/popup url reject-dict
^https:\/\/3pp\.starbucks\.com\.cn\/wxmem\/index\/banner url reject-dict
^https:\/\/3pp\.starbucks\.com\.cn\/wxmem\/index\/global url reject-dict
# --- 石家庄公交乘车码 ---
^https:\/\/wechat-api\.i-xiaoma\.com\.cn\/app\/v1\/bus\/wechat\/content url reject-dict
# --- 闪送 ---
^https:\/\/miniprogram\.ishansong\.com\/cms\/faq\/query url reject-dict
# --- 荣耀亲选 / 潮玩类 ---
^https:\/\/r2\.gzyct\.com\/qrcode\/advert url reject-dict
# --- 美柚 ---
^https:\/\/wxproj\.seeyouyima\.com\/data\/today_tips url reject-dict
# --- 哈啰 ---
^https:\/\/qapi\.huolala\.cn\/ads url reject-dict
# --- 阿那亚 / 乐园类 ---
^https:\/\/apis\.alenable\.com\/mall\/v1\/api\/mall\/skin\/user\/get url reject-dict
^https:\/\/apis\.alenable\.com\/ycx\/v1\/api\/adPut url reject-dict
# --- 芒果 / 打卡类 ---
^https:\/\/dock\.tenchii\.com\/DockCard\/api\/mini\/card\/list url reject-dict
# --- 申通快递 ---
^https:\/\/customer-app\.sto\.cn\/api\/app\/banner\/banner url reject-dict
# --- 中通快递 ---
^https:\/\/hdgateway\.zto\.com\/track url reject-dict
# --- 来点 / 闪送类 ---
^https:\/\/mobile-api\.imlaidian\.com\/api\/args url reject-dict
# --- 怪兽充电 ---
^https:\/\/aag\.enmonster\.com\/apa\/index\/advert\/skin url reject-dict
# --- 松果出行 ---
^https:\/\/api\.songguo7\.com\/(w{3})?mp\/v2\/misc\/(toast|user_operate_info|unlock_without_order|unlock_operate_info) url reject-dict
# --- 拼单 / 团购类 ---
^https:\/\/tm-api\.pin-dao\.cn\/home\/api\/index\/activeConfig\/v2 url reject-dict
^https:\/\/tm-api\.pin-dao\.cn\/home\/api\/resource\/config\/homeBannerNodes url reject-dict
# --- 华住 / 汉庭 / 如家 系 ---
^https:\/\/api-fouth-mem\.huazhu\.com\/api\/rights\/bannerList url reject-dict
^https:\/\/wxapp\.bestwehotel\.com\/gw3\/app-mini\/trip-hotel-banner\/activity\/getActivityInfo url reject-dict
# --- 美团 / 点评 系 ---
^https:\/\/mxsa\.mxbc\.net\/api\/v1\/adinfo\/adplace\/query url reject-dict
# --- 滴滴（青桔 / 代驾 / 顺风车）---
^https:\/\/htwkop\.xiaojukeji\.com\/gateway\?api=cms.htw.delivery url reject-dict
^https:\/\/htwkop\.xiaojukeji\.com\/gateway\?api=hm.fa.combineHomepageInfo url reject-dict
^https:\/\/htwkop\.xiaojukeji\.com\/gateway\?api=hm.fa.mallRecommend url reject-dict
^https:\/\/as\.xiaojukeji\.com\/ep\/as\/conf\?ns=daijia-front&name= url reject-dict
^https:\/\/daijia\.kuaidadi\.com\/gateway\?api=prado\.cms\.delivery\.batch&apiVe url reject-dict
# --- 罗森点点 ---
^https:\/\/lawsonapi\.yorentown\.com\/area\/sh-lawson\/app\/v1\/mina\/systemSetting url reject-dict
# --- 哗啦啦点单系统（大量餐饮小程序底层）---
^https:\/\/cbd-gateway-service-applets\.hualala\.com\/arch\/api\/banner\/QueryBannerImgList url reject-dict
# --- M Stand ---
^https:\/\/api\.prod\.dj\.mstand\.cn\/scrm\/app\/mdm\/index\/listAdv\?types url reject-dict
# --- 享道出行 ---
^https:\/\/passengerapi\.saicmobility\.com\/(ad\/requestAd|pay\/v1\/queryOpenedCouponPackages) url reject-dict
# --- 猫眼（电影 / 演出）---
^https:\/\/ad\.maoyan\.com\/api\/position\/detail url reject-dict
^https:\/\/vod-movie\.maoyan\.com\/vod\/video\/onlineMovies\.json url reject-dict
^https:\/\/api\.maoyan\.com\/sns\/common\/feed\/channel\/v2\/list\.json url reject-dict
# --- 横店电影 ---
^https:\/\/api\.hengdianfilm\.com\/\/cinema\/queryAvailableBannerInfo\/2\?cid= url reject-dict
^https:\/\/api\.hengdianfilm\.com\/\/cinema\/queryAvailableBannerInfo\/4\?cid= url reject-dict
# --- 拼多多（小程序内信息流）---
^https:\/\/api\.pinduoduo\.com\/api\/ktt_gateway\/activity\/feeds\/personal_home_page\/ url reject
# --- 顺丰速运 ---
^https:\/\/ucmp\.sf-express\.com\/proxy\/operation-platform\/info-flow-adver\/query url reject-dict
^https:\/\/ucmp\.sf-express\.com\/proxy\/esgcempcore\/memberGoods\/pointMallService\/goodsList url reject-dict
# ========== C. 风险区（默认全部注释，按需自行开启）==========
# 下面这些是上游插件里的同批规则，但属于「整站 / 整段 CDN / 首页主接口」级 reject，
# 开了会连带打断正常功能。想用请务必先确认代价。
# 极兔速递：整站 reject，会断快递查询
# ^https:\/\/applets\.jtexpress\.com\.cn url reject-dict
# 哈啰：正则里 ? 未转义，且是整站级
# ^https:\/\/api\.hellobike\.com\/api\?adx url reject-dict
# 货拉拉：整站图片 CDN，开了列表没图
# ^https:\/\/appuser-static\.huolala\.cn\/imgs url reject-dict
# 中通：CDN 路径，影响面大
# ^https:\/\/fscdn\.zto\.com\/fs1 url reject-dict
# 申通：阿里云 OSS 图片目录
# ^https:\/\/sto-customer-app\.oss-cn-shanghai\.aliyuncs\.com\/images url reject-dict
# 如家：首页三个主接口，开了首页白屏
# ^https:\/\/app\.homeinns\.com\/api\/v5\/index url reject-dict
# ^https:\/\/app\.homeinns\.com\/api\/v5\/local url reject-dict
# ^https:\/\/app\.homeinns\.com\/api\/v6\/indexs url reject-dict
# 店 SO：整站
# ^https:\/\/smarket\.dian\.so url reject-dict
# ^https:\/\/file\.dian\.so\/c\/leto url reject-dict
# 到家：评价接口，不是广告
# ^https:\/\/suyun-guest\.daojia\.com\/api\/kuaigou\/banjia\/review url reject-dict
# 德邦：会员等级接口，不是广告
# ^https:\/\/www\.deppon\.com\/gwapi\/memberService\/eco\/member\/grade\/commonInterface url reject-dict
# 微信广告素材 CDN：上游标注为「小程序通用规则」，但也有人反馈会影响朋友圈图片/视频加载。
# 开启前请先刷 10 条朋友圈确认图片正常；一旦朋友圈刷不出图，立刻关掉。
# ^https?:\/\/wxsnsdy\.wxs\.qq\.com url reject
# ^https?:\/\/wxsnsdythumb\.wxs\.qq\.com url reject
# ^https?:\/\/wxsmsdy\.video\.qq\.com url reject
hostname = mp.weixin.qq.com, webapi.qmai.cn, creditcardapp.bankcomm.com, webchatapp.fcbox.com, app.95504.net, minipro.95504.net, flow.dmall.com, api.yonghuivip.com, activity.yonghuivip.com, sauron-report.yonghuivip.com, res.pizzahut.com.cn, api.mcd.cn, 3pp.starbucks.com.cn, wechat-api.i-xiaoma.com.cn, miniprogram.ishansong.com, r2.gzyct.com, wxproj.seeyouyima.com, qapi.huolala.cn, apis.alenable.com, dock.tenchii.com, customer-app.sto.cn, hdgateway.zto.com, mobile-api.imlaidian.com, aag.enmonster.com, api.songguo7.com, tm-api.pin-dao.cn, api-fouth-mem.huazhu.com, wxapp.bestwehotel.com, mxsa.mxbc.net, htwkop.xiaojukeji.com, as.xiaojukeji.com, daijia.kuaidadi.com, lawsonapi.yorentown.com, cbd-gateway-service-applets.hualala.com, api.prod.dj.mstand.cn, passengerapi.saicmobility.com, ad.maoyan.com, vod-movie.maoyan.com, api.maoyan.com, api.hengdianfilm.com, api.pinduoduo.com, ucmp.sf-express.com

# ===== source: https://raw.githubusercontent.com/ddgksf2013/Rewrite/master/AdBlock/Applet.conf =====
# 此重写仅针对特定小程序去广告，无法去除小程序5s开屏广告（建议微信开启青少年模式，即可去除小程序开屏及小程序内弹窗）
# 搜罗好货、小野分享、天泽后花园、黑科技软件、酸鸡汤,老爷花苑,御花园、森茂雅苑、小纸箱助手、free 黑科技
# 科技窝、APP基地、AShare、不完全指北、森茂小苑、电视盒子君、公子黑科技、世颜说、搞机师兄、火箭软件库
# 天书乱谈、老胡群英会、天泽百宝箱、老鬼黑科技、黑科技软件源、天书X乱谈、图层黑科技、掌上公交、顺丰速运
# 便利蜂、公众号图文广告、
hostname = api.blibee.com, ucmp.sf-express.com, www.bbkj.work, wx.wxqqurl.cn, wp3.lobdol.cn, awg.enmonster.com, mp.weixin.qq.com, wx.mygolbs.com, jabi.coding.net, api.bspapp.com, 3dd0be8a-54fe-43ff-a0e7-f670c4f20432.bspapp.com, *.tslt.xyz, g.syshhc.top, c.jxjt888.top, www.laoguikeji.cn, qj.bpojie.com, b.tslt.xyz, m.xgjyouhui.com, www.freeheikeji.cn, xcx.xianbaow.com, *.smkj33.top, *.ddly666.top, hkj178.com, a.jxjt888.top, lysl2020.com, www.i3zh.com, iosoi.cn, jabi.coding.net, jt.jxjt888.top, gjsx.vip, d.syshhc.top, gz.gongzijx.com, tvapp.guilaile.cn, www.benbenfx.xyz, 4thdimension.top, api.bspapp.com, tan.ipnas.ltd
# > 小程序_便利蜂@ddgksf2013
^https?:\/\/api\.blibee\.com\/cvsnotify-api\/cvs\/notify\/app\/banner\/v\d+$ url reject-200
# > 小程序_顺丰速运@ddgksf2013
^https?:\/\/ucmp\.sf-express\.com\/proxy\/operation-platform\/info-flow-adver\/query$ url reject-200
# > 公众号_图文去广告@ddgksf2013
# > 小程序_掌上公交@ddgksf2013
^https?:\/\/wx\.mygolbs\.com\/WxBusServer\/ApiData\.do url script-response-body https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/zhangshanggongjiao.js
# > 小程序_去广告@ddgksf2013
^(https?://)?([a-zA-Z0-9]+(-[a-zA-Z0-9]+)*\.)+[a-zA-Z]{2,}(:\d+)?/wp-json/[a-zA-Z0-9_-]+/(mp\/)?v\d/posts url script-response-body https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/applet.js

# ===== source: https://raw.githubusercontent.com/ddgksf2013/Rewrite/master/AdBlock/WeChat.conf =====
hostname = mp.weixin.qq.com
# > 微信公众号去广告[已失效][不包含公众号信息流AD、朋友圈AD][推荐开启青少年模式可去除朋友圈AD]

