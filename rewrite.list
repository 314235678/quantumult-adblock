                    { "name": "英国", "url": "https://itunes.apple.com/WebObjects/MZStore.woa/wa/resetAndRedirect?dsf=143444&mt=8&url=/WebObjects/MZStore.woa/wa/viewSoftware?mt=8&id=1108187390&cc=GB&urlDesc=", "desc": "United Kingdom", "icon": "https://flagcdn.com/w160/gb.png" },
                    { "name": "土耳其", "url": "https://itunes.apple.com/WebObjects/MZStore.woa/wa/resetAndRedirect?dsf=143444&mt=8&url=/WebObjects/MZStore.woa/wa/viewSoftware?mt=8&id=1108187390&cc=TR&urlDesc=", "desc": "Turkey", "icon": "https://flagcdn.com/w160/tr.png" }
