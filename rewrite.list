    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">
<style>
:root{--sidebar-w:240px;--primary:#3b82f6;--bg-body:#f0f2f5;--bg-card:#ffffff;--text-main:#333333;--text-sub:#666666;--border:#e5e7eb;--grid-line:rgba(0, 0, 0, 0.04);--header-h-mobile:60px}
html{background-color:var(--bg-body);transition:background-color .3s}
[data-theme=dark]{--bg-body:#111827;--bg-card:#1f2937;--text-main:#f3f4f6;--text-sub:#9ca3af;--border:#374151;--grid-line:rgba(255, 255, 255, 0.05)}
*{margin:0;padding:0;box-sizing:border-box;outline:0;-webkit-tap-highlight-color:transparent}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;color:var(--text-main);background-color:var(--bg-body);display:flex;height:100vh;overflow:hidden;background-color:var(--bg-body)}
a{text-decoration:none;color:inherit}
.clickable{color:#00f;cursor:pointer;text-decoration:none}
.clickable:hover{text-decoration:underline}
.sidebar{width:var(--sidebar-w);background:var(--bg-card);border-right:1px solid var(--border);display:flex;flex-direction:column;z-index:1100;transition:transform .3s ease;height:100%;flex-shrink:0}
.logo{height:60px;display:flex;align-items:center;padding:0 20px;font-size:1.2rem;font-weight:800;color:var(--primary);border-bottom:1px solid var(--border);cursor:pointer;flex-shrink:0}
.logo i{margin-right:8px;font-size:1.4rem}
.nav-menu{flex:1;overflow-y:auto;padding:10px 0}
.nav-item{width:100%;padding:10px 20px;cursor:pointer;font:inherit;font-size:.9rem;color:var(--text-sub);display:flex;align-items:center;transition:.2s;border:0;border-left:3px solid transparent;background:transparent;text-align:left}
.nav-item i{margin-right:10px;font-size:1.1rem;width:20px;text-align:center}
.nav-item:hover{background:var(--bg-body);color:var(--primary)}
.nav-item.active{background:var(--bg-body);color:var(--primary);border-left-color:var(--primary);font-weight:600}
.sidebar-footer{padding:15px;border-top:1px solid var(--border);font-size:12px;color:var(--text-sub);background:var(--bg-card)}
.run-time{display:block;margin-bottom:5px;opacity:.8}
.app-version{display:inline-block;background:rgba(59,130,246,.1);color:var(--primary);padding:2px 6px;border-radius:4px;font-weight:700}
.dev-tools{padding:15px;border-top:1px solid var(--border);background:var(--bg-card)}
.btn-tool{width:100%;padding:8px;border:1px solid var(--border);background:0 0;color:var(--text-sub);border-radius:6px;margin-top:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:5px;font-size:.85rem;transition:.2s}
.btn-tool:hover{border-color:var(--primary);color:var(--primary)}
.btn-primary{background:var(--primary);color:#fff;border:none}
.sidebar-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1050;display:none;opacity:0;transition:opacity .3s;backdrop-filter:blur(2px)}
.sidebar-overlay.show{display:block;opacity:1}
.main-viewport{flex:1;height:100%;overflow-y:auto;scroll-behavior:smooth;background-image:linear-gradient(var(--grid-line) 1px,transparent 1px),linear-gradient(90deg,var(--grid-line) 1px,transparent 1px);background-size:20px 20px;position:relative}
.banner{height:220px;background-image:url('by.jpg');display:flex;flex-direction:column;justify-content:center;align-items:center;padding:20px;color:#fff;background-size:cover;background-position:center;background-repeat:no-repeat;transition:height .3s;position:relative;isolation:isolate}
.banner::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.2),rgba(0,0,0,.42));z-index:-1}
.banner h1{font-size:1.6rem;margin-bottom:15px;font-weight:700;text-shadow:0 2px 4px rgba(0,0,0,.3);text-align:center}
.search-container{width:100%;max-width:500px;display:flex;flex-direction:column;gap:3px}
.search-bar{position:relative;width:100%}
.search-bar input{width:100%;padding:12px 20px 12px 45px;border-radius:50px;border:none;background:rgba(255,255,255,.95);font-size:.95rem;box-shadow:0 4px 15px rgba(0,0,0,.15);transition:all .3s}
.search-bar i{position:absolute;left:15px;top:50%;transform:translateY(-50%);color:#666}
.notice-bar{height:24px;background:rgba(0,0,0,.2);backdrop-filter:blur(4px);border-radius:12px;display:flex;align-items:center;padding:0 10px;font-size:12px;color:rgba(255,255,255,.9);overflow:hidden;border:1px solid rgba(255,255,255,.15);margin-top:12px}
.notice-icon{margin-right:6px;font-size:12px;animation:bellShake 3s infinite}
.notice-content{flex:1;height:100%;position:relative;overflow:hidden}
.notice-list{list-style:none;position:absolute;top:0;left:0;width:100%;transform:translateY(0);transition:transform .55s cubic-bezier(.4,0,.2,1);will-change:transform}
.notice-item{height:24px;line-height:24px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.notice-item a{color:inherit;display:block;width:100%}
.content-area{padding:30px;max-width:1400px;margin:0 auto;min-height:calc(100vh - 400px)}
.section-header{font-size:1.05rem;color:var(--text-sub);margin:30px 0 15px 0;display:flex;align-items:center;justify-content:space-between;gap:12px;font-weight:600;opacity:.9}
.section-title{display:flex;align-items:center;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.section-title::before{content:"#";margin-right:6px;font-weight:400;font-size:1.1rem;color:#cbd5e1;flex-shrink:0}
.grid-box{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px}
.footer{text-align:center;padding:30px 20px 80px 20px;color:var(--text-sub);font-size:.75rem;line-height:1.6;opacity:.8;border-top:1px dashed var(--border);margin-top:40px}
.card{background:var(--bg-card);border-radius:8px;padding:14px;min-height:72px;display:flex;align-items:center;text-decoration:none;color:inherit;transition:all .2s;position:relative;overflow:hidden;border:1px solid transparent;box-shadow:0 1px 2px rgba(0,0,0,.03);cursor:pointer;content-visibility:auto;contain-intrinsic-size:72px}
.card-nav{min-height:64px;padding:12px 14px;contain-intrinsic-size:64px}
.card:focus-visible,.fab-btn:focus-visible,.btn-tool:focus-visible,.tab-btn:focus-visible,.section-sort-btn:focus-visible,.nav-item:focus-visible,.search-bar input:focus-visible{outline:2px solid var(--primary);outline-offset:3px}
@media (hover:hover){.card:hover{transform:translateY(-2px);box-shadow:0 8px 16px rgba(0,0,0,.06);border-color:rgba(59,130,246,.3)}
}
.card-media{position:relative;width:36px;height:36px;margin-right:12px;flex-shrink:0}
.card-img{width:36px;height:36px;border-radius:7px;background:var(--bg-body);object-fit:cover;display:block}
.card-rank{position:absolute;left:-5px;bottom:-5px;height:16px;min-width:24px;padding:0 5px;border-radius:999px;background:#2563eb;color:#fff;font-size:10px;font-weight:800;line-height:16px;text-align:center;box-shadow:0 2px 6px rgba(37,99,235,.3)}
.card-rank.rank-1{background:#f59e0b;box-shadow:0 2px 6px rgba(245,158,11,.3)}
.card-rank.rank-2{background:#64748b;box-shadow:0 2px 6px rgba(100,116,139,.28)}
.card-rank.rank-3{background:#b45309;box-shadow:0 2px 6px rgba(180,83,9,.26)}
.card-info{flex:1;min-width:0;overflow:hidden;padding-right:44px;display:flex;flex-direction:column;justify-content:center;gap:2px}
.card-nav .card-info{gap:1px}
.card-title{font-size:.9rem;font-weight:700;color:var(--text-main);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:0;line-height:1.4}
.card-desc{font-size:.75rem;color:var(--text-sub);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:0;line-height:1.5}
.card-nav .card-title{line-height:1.35}
.card-nav .card-desc{line-height:1.35}
.card-tag{display:inline-block;font-size:11px;padding:0 6px;border-radius:4px;background:rgba(59,130,246,.1);color:var(--primary);font-weight:500;line-height:1.5;width:fit-content;margin:0}
.card-views{position:absolute;top:7px;right:8px;font-size:10px;color:#f59e0b;background:rgba(245,158,11,.1);padding:1px 5px;border-radius:999px;display:flex;align-items:center;gap:2px;line-height:1.4;max-width:64px}
.view-count{font-weight:600}
.section-sort{display:inline-flex;align-items:center;gap:2px;padding:2px;border:1px solid var(--border);border-radius:999px;background:rgba(255,255,255,.58);flex-shrink:0}
[data-theme=dark] .section-sort{background:rgba(31,41,55,.58)}
.section-sort-btn{height:23px;padding:0 8px;border:0;border-radius:999px;background:transparent;color:var(--text-sub);font-size:.72rem;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:4px;transition:background-color .2s,color .2s}
.section-sort-btn i{font-size:.86rem}
.section-sort-btn.active{background:rgba(59,130,246,.1);color:var(--primary)}
.card-actions{position:absolute;top:0;right:0;display:none;z-index:10}
.card:hover .card-actions{display:flex}
.action-btn{width:24px;height:24px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#fff;font-size:12px}
.btn-edit{background-color:#3b82f6}
.btn-del{background-color:#ef4444;border-bottom-left-radius:6px}
.tab-container{display:flex;background:rgba(0,0,0,.2);border-radius:20px;padding:4px;margin-top:15px;backdrop-filter:blur(4px);border:1px solid rgba(255,255,255,.1);position:relative;z-index:10}
.tab-btn{padding:6px 24px;border-radius:16px;color:rgba(255,255,255,.8);font-size:.9rem;cursor:pointer;transition:all .3s;display:flex;align-items:center;gap:6px;border:none;background:0 0}
.tab-btn.active{background:#fff;color:var(--primary);font-weight:700;box-shadow:0 2px 8px rgba(0,0,0,.1)}
.fab-container{position:fixed;bottom:30px;right:30px;display:flex;flex-direction:column;gap:12px;z-index:100}
.fab-btn{width:44px;height:44px;border-radius:50%;background:var(--bg-card);color:var(--text-sub);border:1px solid var(--border);cursor:pointer;box-shadow:0 4px 10px rgba(0,0,0,.08);display:flex;align-items:center;justify-content:center;font-size:1.1rem;transition:.2s;transform:translateZ(0);-webkit-transform:translateZ(0);will-change:transform,background-color;transition:transform .2s,background-color .3s,border-color .3s,color .2s}
.fab-btn:hover{transform:scale(1.1);color:var(--primary);border-color:var(--primary)}
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);display:none;justify-content:center;align-items:center;z-index:2000;backdrop-filter:blur(3px)}
.modal-box{background:var(--bg-card);width:90%;max-width:400px;padding:24px;border-radius:12px;box-shadow:0 20px 25px -5px rgba(0,0,0,.1)}
.form-row{margin-bottom:12px}
.form-row label{display:block;font-size:.85rem;margin-bottom:4px;color:var(--text-sub)}
.form-row input,.form-row select{width:100%;padding:8px 10px;background:var(--bg-body);border:1px solid var(--border);color:var(--text-main);border-radius:6px;font-size:.9rem}
.modal-btns{display:flex;justify-content:flex-end;gap:10px;margin-top:20px}
.textarea-export{width:100%;height:150px;padding:10px;background:#1e293b;color:#86efac;border-radius:6px;font-family:monospace;font-size:12px;border:none}
.log-scroll-box{max-height:300px;overflow-y:auto;margin:10px 0;padding-right:5px}
.log-scroll-box::-webkit-scrollbar{width:4px}
.log-scroll-box::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px}
.log-modal-box{max-width:420px;padding:0;overflow:hidden;border:1px solid rgba(255,255,255,.5)}
.log-modal-head{display:flex;align-items:center;justify-content:space-between;padding:18px 20px 14px;border-bottom:1px solid var(--border)}
.log-title{display:flex;align-items:center;gap:9px;color:var(--text-main);font-size:1.05rem;font-weight:800}
.log-title i{color:var(--primary);font-size:1.25rem}
.modal-icon-btn{width:30px;height:30px;border:0;border-radius:50%;background:var(--bg-body);color:var(--text-sub);display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:1rem;transition:color .2s,background-color .2s,transform .2s}
.modal-icon-btn:hover{color:var(--primary);background:rgba(59,130,246,.1);transform:rotate(90deg)}
.log-scroll-box.log-body{max-height:360px;margin:0;padding:16px 18px 20px;background:linear-gradient(180deg,rgba(59,130,246,.04),transparent 80px)}
.timeline{border-left:1px solid var(--border);margin-left:8px;padding-left:18px}
.timeline-item{position:relative;margin-bottom:12px;background:var(--bg-card);border:1px solid var(--border);border-radius:8px;padding:12px 12px 12px 14px;box-shadow:0 1px 2px rgba(0,0,0,.03)}
.timeline-item:last-child{margin-bottom:0}
.timeline-item::before{content:'';position:absolute;left:-24px;top:17px;width:9px;height:9px;border-radius:50%;background:var(--primary);box-shadow:0 0 0 4px rgba(59,130,246,.12);z-index:1}
.timeline-date{font-size:.72rem;color:var(--primary);font-weight:700;margin-bottom:7px;display:inline-flex;align-items:center;background:rgba(59,130,246,.1);padding:2px 7px;border-radius:999px}
.timeline-content{font-size:.9rem;color:var(--text-main);line-height:1.55}
#toast-container{position:fixed;top:30px;left:50%;transform:translateX(-50%);z-index:10000;display:flex;flex-direction:column;gap:10px;pointer-events:none}
.toast-msg{background:rgba(0,0,0,.85);backdrop-filter:blur(5px);color:#fff;padding:10px 24px;border-radius:50px;font-size:.9rem;box-shadow:0 5px 15px rgba(0,0,0,.2);display:flex;align-items:center;gap:8px;white-space:nowrap;opacity:0;animation:toastIn .3s cubic-bezier(.18,.89,.32,1.28) forwards}
.toast-success i{color:#4ade80}
.toast-warn i{color:#facc15}
@keyframes toastIn{to{opacity:1;transform:translateY(0)}}
@keyframes toastOut{to{opacity:0;transform:translateY(-20px)}}
@keyframes bellShake{0%,100%{transform:rotate(0)}
10%,30%,50%{transform:rotate(-15deg)}
20%,40%{transform:rotate(15deg)}
60%{transform:rotate(0)}
}
@keyframes spin{from{transform:rotate(0)}
to{transform:rotate(360deg)}
}
.spin-slow{animation:spin 4s linear infinite;display:inline-block;margin-right:4px}
.mobile-header{display:none;position:fixed;top:0;left:0;right:0;height:var(--header-h-mobile);z-index:1000;padding:0 20px;align-items:center;justify-content:space-between;transition:all .4s cubic-bezier(.4, 0, .2, 1);color:#fff}
.mobile-header.scrolled{background:rgba(255,255,255,.9);backdrop-filter:blur(15px);-webkit-backdrop-filter:blur(15px);border-bottom:1px solid rgba(0,0,0,.08);box-shadow:0 4px 20px rgba(0,0,0,.06);color:var(--text-main)}
[data-theme=dark] .mobile-header.scrolled{background:rgba(31,41,55,.9);border-bottom:1px solid rgba(255,255,255,.08);color:var(--text-main)}
.m-logo-icon{font-size:1.5rem;display:flex;align-items:center}
.m-menu-btn{font-size:1.5rem;cursor:pointer}
@media (max-width:768px){body{display:block;height:auto;overflow-y:auto}
.mobile-header{display:flex}
.sidebar{position:fixed;left:-100%;height:100%;top:0;transform:translateX(0);left:-100%;transition:left .3s cubic-bezier(.4, 0, .2, 1);box-shadow:5px 0 15px rgba(0,0,0,.1)}
.sidebar.show{left:0}
.main-viewport{height:auto;overflow:visible}
.banner{padding-top:var(--header-h-mobile);height:auto;min-height:auto;padding-bottom:15px}
.banner h1{font-size:1.25rem;margin-top:1px;margin-bottom:8px}
.search-container{gap:6px}
.tab-container{margin-top:6px!important;padding:3px}
.tab-btn{padding:4px 16px;font-size:.85rem}
.search-bar input{padding:8px 15px 8px 40px;font-size:.85rem;height:36px}
.search-bar i{font-size:.9rem;left:12px}
.content-area{padding:15px}
.section-header{margin:28px 0 12px 0;gap:8px}
.section-sort{padding:1px}
.section-sort-btn{height:22px;padding:0 7px;font-size:.7rem}
.grid-box{grid-template-columns:repeat(2,1fr);gap:10px}
.card{padding:10px;min-height:116px;flex-direction:column;align-items:flex-start;text-align:left;justify-content:flex-start}
.card-nav{min-height:100px;contain-intrinsic-size:100px}
.card-media{width:32px;height:32px;margin-right:0;margin-bottom:9px}
.card-nav .card-media{margin-bottom:7px}
.card-img{width:32px;height:32px}
.card-rank{left:-4px;bottom:-5px;height:15px;min-width:22px;font-size:9px;line-height:15px}
.card-info{width:100%;padding-right:0;gap:2px}
.card-title{white-space:nowrap;display:block;min-height:0}
.card-desc{width:100%;white-space:nowrap}
.card-tag{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.card-views{top:8px;right:8px;font-size:9px;padding:1px 5px;max-width:56px}
#mobileMenuBtn{display:none!important}
}
#toTopBtn{position:relative;border:none;background:var(--bg-card);box-shadow:0 4px 10px rgba(0,0,0,.1);padding:0;overflow:visible}
.progress-ring{position:absolute;top:0;left:0;width:100%;height:100%;transform:rotate(-90deg);pointer-events:none}
.progress-ring__bg{stroke:var(--border);transition:stroke .3s}
.progress-ring__circle{stroke:var(--primary);transition:stroke-dashoffset .1s linear;transform-origin:50% 50%;stroke-linecap:round}
#toTopBtn i{position:relative;z-index:2}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.01ms!important}
}
